figure.figsize: 6, 3.6
figure.dpi: 100
figure.facecolor: white
savefig.dpi: 200
savefig.facecolor: white

font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
font.size: 10
axes.titlesize: 11
axes.labelsize: 10
legend.fontsize: 9

axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.linewidth: 0.8
axes.edgecolor: 444444
axes.labelcolor: 222222
axes.prop_cycle: cycler('color', ['b5533c', '3b6ea5', 'a8791d', '7a4f9e', '5f8a3a'])

lines.linewidth: 1.6
lines.markersize: 5
legend.frameon: False
xtick.direction: out
ytick.direction: out
xtick.color: 444444
ytick.color: 444444
xtick.labelcolor: 222222
ytick.labelcolor: 222222
